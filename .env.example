# Copy to .env to override. Defaults below match `npm run db:up`.
#
# These are throwaway credentials for a local Docker container that is not
# reachable from outside your machine. They are deliberately in the repo.
#
# WARNING: .env is gitignored for a reason. If you point these at a real Tiger
# Cloud service, keep the credentials in .env and never commit them.
PGHOST=localhost
PGPORT=5433
PGUSER=postgres
PGPASSWORD=tigerlab
PGDATABASE=tigerlab

# Point these at a Tiger Cloud service to run the lessons there instead.
# PGHOST=<service>.tsdb.cloud.timescale.com
# PGPORT=xxxxx
# PGSSLMODE=require

# Optional: enable the contextual AI tutor in `npm run play`. The key is only
# read by the local server and is never sent to the browser.
# OPENAI_API_KEY=<your-api-key>
# OPENAI_MODEL=gpt-4o-mini
# Set this for an OpenAI-compatible provider; it must expose /chat/completions.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Free local option: install Ollama, run `ollama pull qwen2.5:3b`, then use:
# OPENAI_API_KEY=
# OPENAI_MODEL=qwen2.5:3b
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Copy to .env to override. Defaults below match `npm run db:up`.
#
# These are throwaway credentials for a local Docker container that is not
# reachable from outside your machine. They are deliberately in the repo.
#
# WARNING: .env is gitignored for a reason. If you point these at a real Tiger
# Cloud service, keep the credentials in .env and never commit them.
PGHOST=localhost
PGPORT=5433
PGUSER=postgres
PGPASSWORD=tigerlab
PGDATABASE=tigerlab

# Point these at a Tiger Cloud service to run the lessons there instead.
# PGHOST=<service>.tsdb.cloud.timescale.com
# PGPORT=xxxxx
# PGSSLMODE=require
